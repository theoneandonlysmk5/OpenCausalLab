# Survey microdata and large intermediates (rebuild from Dataverse)
studies/*/data/raw/**
!studies/*/data/raw/.gitkeep
studies/*/data/intermediate/**
!studies/*/data/intermediate/.gitkeep
studies/*/data/final/*.parquet
studies/*/data/final/**/*.parquet
studies/*/data/final/tables.zip

# Keep small table/validation CSV outputs in git
!studies/*/data/final/tables/
!studies/*/data/final/tables/**
!studies/*/data/final/validation/
!studies/*/data/final/validation/**
!studies/*/data/final/samples/
!studies/*/data/final/samples/.gitkeep

# Row-level audit dumps (IDs or one-row-per-observation) — never track
studies/*/data/final/validation/table5_wage_obs_flags.csv
studies/*/data/final/validation/table6_firm_size_contributions.csv

__pycache__/
*.py[cod]
*$py.class
.venv/
../.venv/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
*.egg-info/
.coverage
htmlcov/
coverage.xml
dist/
artifacts/

